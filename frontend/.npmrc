# Replace the three placeholders with the Azure DevOps organization, feed, and
# npm scope that own your private packages. Authentication is supplied at build
# time by the NpmAuthenticate Azure Pipelines task; never commit a token here.
@YOUR_NPM_SCOPE:registry=https://pkgs.dev.azure.com/YOUR_AZURE_DEVOPS_ORGANIZATION/_packaging/YOUR_AZURE_ARTIFACTS_FEED/npm/registry/
always-auth=true
