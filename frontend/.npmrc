# Replace the placeholders with the Azure DevOps organization, feed, and npm
# scope that own your private packages. Use the first URL for an
# organization-scoped feed. For a project-scoped feed, comment out the first
# URL and use the second one with the Azure DevOps project name. Authentication
# is supplied at build time by NpmAuthenticate; never commit a token here.
@YOUR_NPM_SCOPE:registry=https://pkgs.dev.azure.com/YOUR_AZURE_DEVOPS_ORGANIZATION/_packaging/YOUR_AZURE_ARTIFACTS_FEED/npm/registry/
# @YOUR_NPM_SCOPE:registry=https://pkgs.dev.azure.com/YOUR_AZURE_DEVOPS_ORGANIZATION/YOUR_AZURE_DEVOPS_PROJECT/_packaging/YOUR_AZURE_ARTIFACTS_FEED/npm/registry/
always-auth=true
